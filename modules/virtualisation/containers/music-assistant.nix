# tags: music-assistant, server, podman
{ lib, config, ... }:

{
  # Runtime
  virtualisation.podman = {
    enable = true;
    autoPrune.enable = true;
    dockerCompat = true;
  };

  # Enable container name DNS for all Podman networks.
  networking.firewall.interfaces = let
    matchAll = if !config.networking.nftables.enable then "podman+" else "podman*";
  in {
    "${matchAll}".allowedUDPPorts = [ 53 ];
  };

  virtualisation.oci-containers.backend = "podman";

  # Containers
  virtualisation.oci-containers.containers."music-assistant-server" = {
    image = "ghcr.io/sproft/ytmusic-free-provider:beta";
    environment = {
      "LOG_LEVEL" = "info";
    };
    volumes = [
      "/home/${config.mainUser}/Docker/music-assistant/data:/data:rw"
      "/home/${config.mainUser}/Docker/music-assistant/music:/media:ro"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network=host"
    ];
  };
  systemd.services."podman-music-assistant-server" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container music-assistant-server generated by compose2nix.";
    partOf = [
      "podman-compose-music-assistant-root.target"
    ];
    wantedBy = [
      "podman-compose-music-assistant-root.target"
    ];
  };
  virtualisation.oci-containers.containers."server-aux-player" = {
    image = "giof71/squeezelite:latest";
    environment = {
      "SQUEEZELITE_AUDIO_DEVICE" = "hw:0,0";
      "SQUEEZELITE_NAME" = "Room Speakers";
      "SQUEEZELITE_SERVER_PORT" = "127.0.0.1";
    };
    log-driver = "journald";
    extraOptions = [
      "--device=/dev/snd:/dev/snd:rwm"
      "--network=host"
      "--privileged"
    ];
  };
  systemd.services."podman-server-aux-player" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
    };
    unitConfig.Description = "Container server-aux-player generated by compose2nix.";
    partOf = [
      "podman-compose-music-assistant-root.target"
    ];
    wantedBy = [
      "podman-compose-music-assistant-root.target"
    ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."podman-compose-music-assistant-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
