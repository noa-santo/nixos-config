# tags: server, openproject, podman
# Originally generated by compose2nix, then hand-edited:
#  - the proxy image is built automatically (build repo is cloned if missing)
#  - secrets come from sops-nix (secrets/openproject_secrets.yaml)
{
  pkgs,
  lib,
  config,
  ...
}:

let
  host = "projects.owo.computer";

  deployRepo = "https://github.com/opf/openproject-docker-compose.git";
  deployBranch = "stable/17";
  deployDir = "/var/lib/openproject-docker-compose";
  proxyContext = "${deployDir}/proxy";

  rootTarget = "podman-compose-openproject-root.target";
  buildUnit = "podman-build-openproject-proxy.service";
  netUnit = n: "podman-network-openproject_${n}.service";

  ph = config.sops.placeholder;

  commonEnv = {
    "IMAP_ENABLED" = "false";
    "OPENPROJECT_ADDITIONAL__HOST__NAMES" = "web";
    "OPENPROJECT_CACHE__MEMCACHE__SERVER" = "cache:11211";
    "OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__URL" = "wss://${host}/hocuspocus";
    "OPENPROJECT_HOST__NAME" = host;
    "OPENPROJECT_HSTS" = "true";
    "OPENPROJECT_HTTPS" = "true";
    "OPENPROJECT_RAILS__CACHE__STORE" = "memcache";
    "OPENPROJECT_RAILS__RELATIVE__URL__ROOT" = "";
    "RAILS_MAX_THREADS" = "16";
    "RAILS_MIN_THREADS" = "4";
  };

  appBase = {
    image = "openproject/openproject:17-slim";
    environment = commonEnv;
    environmentFiles = [ config.sops.templates."openproject-app.env".path ];
    volumes = [ "/var/openproject/assets:/var/openproject/assets:rw" ];
    log-driver = "journald";
  };

  appDeps = [
    "openproject-cache"
    "openproject-db"
    "openproject-seeder"
  ];

  # systemd unit boilerplate shared by every container
  mkUnit =
    {
      name,
      nets,
      restart ? "always",
      extraService ? { },
      extraDeps ? [ ],
    }:
    {
      serviceConfig = {
        Restart = lib.mkOverride 90 restart;
      }
      // extraService;
      unitConfig.Description = "Container openproject-${name}";
      after = map netUnit nets ++ extraDeps;
      requires = map netUnit nets ++ extraDeps;
      partOf = [ rootTarget ];
      wantedBy = [ rootTarget ];
    };

  mkNetwork = n: {
    unitConfig.Description = "Network openproject_${n}";
    path = [ pkgs.podman ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "podman network rm -f openproject_${n}";
    };
    script = ''
      podman network inspect openproject_${n} || podman network create openproject_${n}
    '';
    partOf = [ rootTarget ];
    wantedBy = [ rootTarget ];
  };

  containerUnits = {
    autoheal = mkUnit {
      name = "autoheal";
      nets = [ "default" ];
      restart = "no";
    };
    cache = mkUnit {
      name = "cache";
      nets = [ "backend" ];
    };
    cron = mkUnit {
      name = "cron";
      nets = [ "backend" ];
    };
    db = mkUnit {
      name = "db";
      nets = [ "backend" ];
      extraService.TimeoutStopSec = lib.mkOverride 90 8;
    };
    hocuspocus = mkUnit {
      name = "hocuspocus";
      nets = [
        "backend"
        "frontend"
      ];
    };
    proxy = mkUnit {
      name = "proxy";
      nets = [ "frontend" ];
      extraDeps = [ buildUnit ];
      extraService.RestartSec = lib.mkOverride 90 "5s";
    };
    seeder = mkUnit {
      name = "seeder";
      nets = [ "backend" ];
      restart = "on-failure";
    };
    web = mkUnit {
      name = "web";
      nets = [
        "backend"
        "frontend"
      ];
    };
    worker = mkUnit {
      name = "worker";
      nets = [ "backend" ];
    };
  };
in
{
  virtualisation.podman = {
    enable = true;
    autoPrune.enable = true;
    dockerCompat = true;
    dockerSocket.enable = true;
  };

  networking.firewall.interfaces =
    let
      matchAll = if !config.networking.nftables.enable then "podman+" else "podman*";
    in
    {
      "${matchAll}".allowedUDPPorts = [ 53 ];
    };

  virtualisation.oci-containers.backend = "podman";

  sops.secrets = lib.genAttrs [
    "openproject_db_password"
    "openproject_secret_key_base"
    "openproject_hocuspocus_secret"
  ] (_: {
    sopsFile = ../../../secrets/openproject_secrets.yaml;
  });

  sops.templates."openproject-app.env" = {
    restartUnits = [
      "podman-openproject-web.service"
      "podman-openproject-worker.service"
      "podman-openproject-cron.service"
      "podman-openproject-seeder.service"
    ];
    content = ''
      DATABASE_URL=postgres://postgres:${ph.openproject_db_password}@db/openproject?pool=20&encoding=unicode&reconnect=true
      SECRET_KEY_BASE=${ph.openproject_secret_key_base}
      OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__SECRET=${ph.openproject_hocuspocus_secret}
    '';
  };

  sops.templates."openproject-db.env" = {
    restartUnits = [ "podman-openproject-db.service" ];
    content = ''
      POSTGRES_PASSWORD=${ph.openproject_db_password}
    '';
  };

  sops.templates."openproject-hocuspocus.env" = {
    restartUnits = [ "podman-openproject-hocuspocus.service" ];
    content = ''
      SECRET=${ph.openproject_hocuspocus_secret}
    '';
  };

  virtualisation.oci-containers.containers = {
    "openproject-autoheal" = {
      image = "willfarrell/autoheal:1.2.0";
      environment = {
        "AUTOHEAL_CONTAINER_LABEL" = "autoheal";
        "AUTOHEAL_INTERVAL" = "30";
        "AUTOHEAL_START_PERIOD" = "600";
      };
      volumes = [ "/var/run/docker.sock:/var/run/docker.sock:rw" ];
      log-driver = "journald";
      extraOptions = [
        "--network-alias=autoheal"
        "--network=openproject_default"
      ];
    };

    "openproject-cache" = {
      image = "memcached";
      log-driver = "journald";
      extraOptions = [
        "--network-alias=cache"
        "--network=openproject_backend"
      ];
    };

    "openproject-cron" = appBase // {
      cmd = [ "./docker/prod/cron" ];
      dependsOn = appDeps;
      extraOptions = [
        "--network-alias=cron"
        "--network=openproject_backend"
      ];
    };

    "openproject-db" = {
      image = "postgres:17";
      environment."POSTGRES_DB" = "openproject";
      environmentFiles = [ config.sops.templates."openproject-db.env".path ];
      volumes = [ "/var/lib/postgresql/data:/var/lib/postgresql/data:rw" ];
      log-driver = "journald";
      extraOptions = [
        "--network-alias=db"
        "--network=openproject_backend"
        "--stop-timeout=3"
      ];
    };

    "openproject-hocuspocus" = {
      image = "openproject/hocuspocus:17.7.2";
      environment = {
        "OPENPROJECT_HTTPS" = "true";
        "OPENPROJECT_URL" = "http://web:8080";
      };
      environmentFiles = [ config.sops.templates."openproject-hocuspocus.env".path ];
      log-driver = "journald";
      extraOptions = [
        "--network-alias=hocuspocus"
        "--network=openproject_backend"
        "--network=openproject_frontend"
      ];
    };

    "openproject-proxy" = {
      image = "localhost/openproject/proxy";
      ports = [ "8482:80/tcp" ];
      dependsOn = [ "openproject-web" ];
      log-driver = "journald";
      extraOptions = [
        "--network-alias=proxy"
        "--network=openproject_frontend"
      ];
    };

    "openproject-seeder" = appBase // {
      cmd = [ "./docker/prod/seeder" ];
      extraOptions = [
        "--network-alias=seeder"
        "--network=openproject_backend"
      ];
    };

    "openproject-web" = appBase // {
      cmd = [ "./docker/prod/web" ];
      labels."autoheal" = "true";
      dependsOn = appDeps;
      extraOptions = [
        "--health-cmd=[\"curl\", \"-f\", \"http://localhost:8080/health_checks/default\"]"
        "--health-interval=15s"
        "--health-retries=5"
        "--health-start-period=300s"
        "--health-timeout=5s"
        "--hostname=${host}"
        "--network-alias=web"
        "--network=openproject_backend"
        "--network=openproject_frontend"
      ];
    };

    "openproject-worker" = appBase // {
      cmd = [ "./docker/prod/worker" ];
      dependsOn = appDeps;
      extraOptions = [
        "--network-alias=worker"
        "--network=openproject_backend"
      ];
    };
  };

  systemd.services =
    lib.mapAttrs' (n: v: lib.nameValuePair "podman-openproject-${n}" v) containerUnits
    // lib.genAttrs' [
      "backend"
      "default"
      "frontend"
    ] (n: lib.nameValuePair "podman-network-openproject_${n}" (mkNetwork n))
    // {
      # Clones the build repo if missing, then builds the proxy image.
      # To pick up upstream changes: rm -rf ${deployDir}; systemctl restart ${buildUnit}
      "podman-build-openproject-proxy" = {
        unitConfig.Description = "Build the OpenProject proxy image";
        path = [
          pkgs.podman
          pkgs.git
        ];
        wants = [ "network-online.target" ];
        after = [ "network-online.target" ];
        before = [ "podman-openproject-proxy.service" ];
        partOf = [ rootTarget ];
        wantedBy = [ rootTarget ];
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
          TimeoutSec = 600;
        };
        script = ''
          set -euo pipefail
          if [ ! -d "${deployDir}/.git" ]; then
            rm -rf "${deployDir}"
            git clone --depth 1 --branch ${deployBranch} ${deployRepo} "${deployDir}"
          fi
          podman build -t openproject/proxy --build-arg APP_HOST=web "${proxyContext}"
        '';
      };
    };

  systemd.targets."podman-compose-openproject-root" = {
    unitConfig.Description = "OpenProject (podman) root target";
    wantedBy = [ "multi-user.target" ];
  };
}

